# Copia este archivo a ".env" y rellénalo SOLO si quieres respuestas con un LLM.
# Sin esto, el agente funciona en modo local (extractivo), sin coste y sin claves.

# Clave de OpenAI (o compatible). Déjalo vacío para modo local.
OPENAI_API_KEY=

# Opcional: endpoint compatible con la API de OpenAI (Ollama, Groq, etc.)
OPENAI_BASE_URL=

# Opcional: modelo a usar cuando hay clave.
RAG_MODEL=gpt-4o-mini

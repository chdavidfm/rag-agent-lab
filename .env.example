# Copy this file to ".env"; the agent loads it automatically on startup.
# Variables already present in the environment take precedence over this file.

# --- Retrieval ------------------------------------------------------------
# Folder of documents to index.
RAG_DOCS_DIR=data/sample
# Strategy: "tfidf" (lexical), "embeddings" (semantic) or "hybrid" (both).
RAG_BACKEND=tfidf
# Encoder used by the dense backend.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Passages returned per query.
RAG_TOP_K=3
# Document chunking, in characters.
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# --- Reranking (optional) -------------------------------------------------
# Reorder candidates with a cross-encoder for higher precision.
RAG_RERANK=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Index cache ----------------------------------------------------------
# Where the built index is persisted, so restarts are instant.
RAG_CACHE_DIR=.rag_cache

# --- Answer generation (optional) -----------------------------------------
# Without a key the agent answers in local, extractive mode.
OPENAI_API_KEY=
# Any endpoint compatible with the OpenAI API (Ollama, Groq, ...).
OPENAI_BASE_URL=
RAG_MODEL=gpt-4o-mini

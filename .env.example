# Copia este archivo a ".env"; el agente lo carga automáticamente al arrancar.
# Las variables ya presentes en el entorno tienen prioridad sobre este archivo.

# --- Recuperación ---------------------------------------------------------
# Carpeta de documentos a indexar.
RAG_DOCS_DIR=data/sample
# Estrategia: "tfidf" (léxica, sin descargas) o "embeddings" (semántica).
RAG_BACKEND=tfidf
# Modelo para el backend denso.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Fragmentos recuperados por consulta.
RAG_TOP_K=3
# Troceado de documentos, en caracteres.
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# --- Generación con LLM (opcional) ---------------------------------------
# Sin clave, el agente responde en modo local extractivo.
OPENAI_API_KEY=
# Endpoint compatible con la API de OpenAI (Ollama, Groq...).
OPENAI_BASE_URL=
RAG_MODEL=gpt-4o-mini
